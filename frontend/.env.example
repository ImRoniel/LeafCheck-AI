# Android emulator; use http://localhost:3000 for web.
# Physical phones need the development computer's reachable LAN address.
EXPO_PUBLIC_API_URL=http:// 192.168.18.143:3000
# Physical device: replace the value above with http://<YOUR-LOCAL-IP>:3000
# Example only: EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
# Find the computer's Wi-Fi/Ethernet IPv4 address with ipconfig on Windows.
# Phone and computer must share a LAN; allow inbound TCP 3000 in the firewall
# and ensure the backend listens on a LAN-accessible interface.
# localhost points to the phone itself; 10.0.2.2 works only in Android Emulator.
# Expo's tunnel exposes Metro, not the API. Use a reachable API URL separately.
# After changing this file's values in .env, restart Expo and fully reload the app.
# Never add database credentials or AI provider keys here.
# Browser authentication requires same-site HTTPS frontend/API deployment and an
# exact frontend origin in server AUTH_ALLOWED_ORIGINS. HTTP localhost cannot
# exercise this backend's Secure __Host- cookie contract. Use an HTTPS dev proxy.
# EXPO_PUBLIC_API_URL=https://api.leafcheck.example
