// ─────────────────────────────────────────────────────────────────────────────
// LeafCheck — PostgreSQL Schema (Relational Domain Entities)
//
// All domain entities live here. MongoDB handles only SensorReading telemetry.
// Generator outputs to a custom path to avoid collision with the MongoDB client.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/postgres-client"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "admin_security"]
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
  LEAD_DEV
  @@schema("public")
}

enum DeviceProvisionStatus {
  APPROVED
  REVOKED
  @@schema("public")
}

// ─── Core Domain Models ───────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String
  passwordChangedAt DateTime? @default(now())
  supabaseUserId String? @unique
  emailVerifiedAt DateTime?
  isActive  Boolean  @default(true)
  role      Role     @default(USER)
  authVersion Int    @default(0)
  authInvalidBefore DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices Device[]
  plants  Plant[]
  sessions AuthSession[]
  careTasks CareTask[]
  analyses  AIAnalysis[]
  adminChallenges AdminChallenge[]
  adminVerifications AdminSessionVerification[]
  auditLogs AuditLog[]
  deviceProvisions DeviceProvision[] @relation("ProvisionCreator")
  platformSettings PlatformSettings[] @relation("SettingsUpdater")
  @@schema("public")
}

/// A password-verified, single-use challenge. Never stores an OTP or raw token.
model AdminChallenge {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email          String
  supabaseUserId String
  challengeHash  String    @unique
  expiresAt      DateTime
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())
  lastSentAt     DateTime  @default(now())
  authVersion    Int       @default(0)
  client         String
  origin         String?

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@schema("admin_security")
}

model AdminSessionVerification {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  supabaseSessionId String   @unique
  verifiedAt        DateTime @default(now())
  expiresAt         DateTime
  authVersion       Int      @default(0)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@schema("admin_security")
}

/// Actor deletion preserves the event and its immutable actorId metadata snapshot.
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  targetId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt, id])
  @@index([actorId, createdAt])
  @@index([targetId, createdAt])
  @@index([action, createdAt])
  @@schema("admin_security")
}

model AuthSession {
  id        String @id @default(uuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@schema("public")
}

model RefreshToken {
  id        String @id @default(uuid())
  tokenHash String @unique
  sessionId String
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  consumedAt DateTime?

  @@index([sessionId])
  @@schema("public")
}

model Device {
  id         String   @id @default(uuid())
  name       String
  macAddress String   @unique
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Version zero belongs to the original, pre-transfer owner. Claims advance it.
  claimVersion Int    @default(0)
  claimedAt  DateTime?
  status     String   @default("OFFLINE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  plants         Plant[]
  pairingHistory DevicePairingHistory[]
  provision DeviceProvision?
  @@schema("public")
}

/// Authorization registry; device credentials remain a separate firmware milestone.
model DeviceProvision {
  id String @id @default(uuid())
  macAddress String @unique
  label String?
  status DeviceProvisionStatus @default(APPROVED)
  claimedDeviceId String? @unique
  claimedDevice Device? @relation(fields: [claimedDeviceId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy User? @relation("ProvisionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@schema("public")
}

model PlatformSettings {
  id String @id @default("platform")
  aiScanningEnabled Boolean @default(true)
  deviceClaimsEnabled Boolean @default(true)
  updatedById String?
  updatedBy User? @relation("SettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt DateTime @updatedAt
  @@schema("public")
}

model Plant {
  id            String    @id @default(uuid())
  name          String
  species       String
  location      String?
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // One current holder per device is enforced by the migration's partial index.
  // Keep the list relation on Device for existing inventory consumers.
  deviceId      String?
  device        Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  healthStatus  String    @default("healthy")
  minMoisture   Float     @default(30.0)
  maxMoisture   Float     @default(80.0)
  lastScannedAt DateTime?
  imageUrl      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  identifications PlantIdentification[]
  analyses        AIAnalysis[]
  careTasks       CareTask[]
  pairingHistory  DevicePairingHistory[]
  @@schema("public")
}

/// Pairing intervals use [pairedAt, unpairedAt); a null end means currently paired.
/// Open-session uniqueness and interval ordering are native migration constraints.
/// Pairing transitions and verified legacy imports must also prevent overlaps.
model DevicePairingHistory {
  id         String    @id @default(uuid())
  deviceId   String
  // The migration defers this FK until commit to support User -> Plant cascades.
  device     Device    @relation(fields: [deviceId], references: [id], onDelete: NoAction)
  plantId    String
  plant      Plant     @relation(fields: [plantId], references: [id], onDelete: Cascade)
  pairedAt   DateTime  @default(now())
  unpairedAt DateTime?

  @@index([plantId, pairedAt])
  @@index([deviceId, unpairedAt])
  @@schema("public")
}

// ─── AI Scanner Pipeline Models ───────────────────────────────────────────────

/// Cached ideal environmental specs per species (populated from Perenual API).
/// pH values here are botanical reference data, NOT live sensor readings.
model PlantSpecCache {
  id                String   @id @default(uuid())
  speciesName       String   @unique
  commonName        String?
  idealLuxMin       Int?
  idealLuxMax       Int?
  idealTempMinC     Float?
  idealTempMaxC     Float?
  idealHumidityMin  Float?
  idealHumidityMax  Float?
  idealPhMin        Float?
  idealPhMax        Float?
  wateringFrequency String?
  sunlight          String?
  rawJson           Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@schema("public")
}

/// Records each Pl@ntNet species identification attempt.
model PlantIdentification {
  id          String   @id @default(uuid())
  plantId     String
  plant       Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  speciesName String
  commonName  String?
  confidence  Float
  imageUrl    String?
  rawResponse Json?
  createdAt   DateTime @default(now())
  @@schema("public")
}

/// Stores Gemini AI diagnostic reports with telemetry snapshots.
model AIAnalysis {
  id                String    @id @default(uuid())
  plantId           String
  plant             Plant     @relation(fields: [plantId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthStatus      String
  diagnoses         Json
  recommendations   Json
  rawAnalysisText   String?
  speciesName       String?
  telemetrySnapshot Json?
  idealSpecs        Json?
  notificationTime  DateTime?
  notificationReason String?
  isArchived        Boolean   @default(true)
  archivedAt        DateTime? @default(now())
  createdAt         DateTime  @default(now())

  careTasks         CareTask[]

  @@index([userId, isArchived])
  @@index([plantId])
  @@schema("public")
}

/// Upcoming manual care tasks generated by Gemini AI
model CareTask {
  id          String      @id @default(uuid())
  plantId     String
  plant       Plant       @relation(fields: [plantId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisId  String?
  analysis    AIAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  title       String
  taskType    String      @default("WATERING")
  description String?
  status      String      @default("PENDING")
  urgency     String      @default("routine")
  dueDate     DateTime
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId, status, dueDate])
  @@index([plantId])
  @@schema("public")
}
