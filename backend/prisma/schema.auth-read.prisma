// Query-only projection of Supabase-owned tables. NEVER migrate or db push this schema.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/auth-read-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["auth"]
}

model ProviderSession {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  createdAt DateTime? @map("created_at") @db.Timestamptz(6)
  notAfter  DateTime? @map("not_after") @db.Timestamptz(6)

  @@map("sessions")
  @@schema("auth")
}

model ProviderUser {
  id               String    @id @db.Uuid
  email            String?   @db.VarChar(255)
  emailConfirmedAt DateTime? @map("email_confirmed_at") @db.Timestamptz(6)
  bannedUntil      DateTime? @map("banned_until") @db.Timestamptz(6)

  @@map("users")
  @@schema("auth")
}
