// ─────────────────────────────────────────────────────────────────────────────
// LeafCheck — MongoDB Schema (Time-Series Telemetry Only)
//
// This schema contains ONLY sensor readings from ESP32 hardware.
// All relational domain entities live in schema.postgres.prisma.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model SensorReading {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  deviceId        String
  // PostgreSQL UUID strings; cross-database references are resolved by the server.
  // Missing contextVersion identifies legacy documents. Do not add a default:
  // ingestion must explicitly mark new paired and unpaired readings with version 1.
  plantId         String?
  pairingId       String?
  contextVersion  Int?
  temperature     Float
  humidity        Float
  soilMoisture    Float?
  soilMoistureRaw Int?
  lightLevel      Float?
  lightLux        Float?
  timestamp       DateTime @default(now()) @map("deviceTimestamp")

  @@index([deviceId, timestamp(sort: Desc)])
  @@index([plantId, timestamp(sort: Desc)])
  @@index([pairingId, timestamp(sort: Desc)])
  @@map("sensorReadings")
}
