// ─────────────────────────────────────────────────────────────────────────────
// LeafCheck — MongoDB Schema (Time-Series Telemetry Only)
//
// This schema contains ONLY sensor readings from ESP32 hardware.
// All relational domain entities live in schema.postgres.prisma.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model SensorReading {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  deviceId        String
  temperature     Float
  humidity        Float
  soilMoisture    Float
  soilMoistureRaw Int?
  lightLevel      Float?
  timestamp       DateTime @default(now())

  @@index([deviceId, timestamp(sort: Desc)])
}
