{
  "name": "leaf-check-ai-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run db:generate:all",
    "dev": "node --import tsx/esm src/server.ts",
    "predev:watch": "npm run db:generate:all",
    "dev:watch": "node --watch --import tsx/esm src/server.ts",
    "build": "npm run db:generate:all && tsc && node scripts/package-prisma-client.mjs",
    "test": "node --import tsx/esm --experimental-test-module-mocks --test tests/*.test.mjs",
    "test:admin-security": "node scripts/test-admin-security.mjs",
    "test:plant-pairing": "node scripts/test-plant-pairing.mjs",
    "test:plant-telemetry": "node scripts/test-plant-pairing.mjs --plant-telemetry",
    "backfill:pairing-sessions": "node --import tsx/esm scripts/backfill-open-pairing-sessions.mjs",
    "backfill:device-provisions": "node --import tsx/esm scripts/backfill-device-provisions.mjs",
    "test:scan-persistence": "node scripts/test-scan-persistence.mjs",
    "test:telemetry-schema": "node scripts/test-telemetry-schema.mjs",
    "start": "node dist/server.js",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:generate:pg": "prisma generate --schema=prisma/schema.postgres.prisma",
    "db:generate:auth-read": "prisma generate --schema=prisma/schema.auth-read.prisma",
    "auth:migration:dry-run": "node --import tsx/esm scripts/auth-migration-dry-run.mjs",
    "auth:migration:apply": "node --import tsx/esm scripts/auth-migration-apply.mjs",
    "db:push:pg": "prisma db push --schema=prisma/schema.postgres.prisma",
    "db:generate:all": "npm run db:generate && npm run db:generate:pg && npm run db:generate:auth-read",
    "db:push:all": "npm run db:push && npm run db:push:pg"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "hash-wasm": "^4.12.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "sharp": "^0.34.5",
    "tasknotes-nlp-core": "0.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^26.4.0",
    "effect": "^3.20.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  },
  "private": true
}
